{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "xmake",
            "args": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "flash",
            "type": "process",
            "command": "E:/APP/MRS2/MounRiver_Studio2/resources/app/resources/win32/components/WCH/OpenOCD/OpenOCD/bin/openocd.exe",
            "args": [
                "-s",
                ".",
                "-f",
                "tools/wch-interface.cfg",
                "-c",
                "program build/cross/riscv/debug/CH32V208GBU_Templete.elf verify",
                "-c",
                "reset run",
                "-c",
                "exit"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Write-Host 'Cleaning xmake build...'; xmake c; Write-Host 'Cleaning cmake build...'; Remove-Item -Recurse -Force -ErrorAction SilentlyContinue build,.xmake"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}